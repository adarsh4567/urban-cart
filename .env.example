PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
# Set this to use MongoDB replica-set transactions. Otherwise the app uses an in-memory demo store.
# MONGODB_URI=mongodb://localhost:27017/urbancart?replicaSet=rs0
# MONGODB_DB_NAME=urbancart
# Production only: set NODE_ENV=production, MONGODB_URI, JWT_SECRET, and ADMIN_PASSWORD.
# ADMIN_EMAIL=admin@urbancart.test
# ADMIN_PASSWORD=use-a-private-password-with-at-least-12-characters
